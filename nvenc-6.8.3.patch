+H264NvencEncoder::~H264NvencEncoder()
+{
+    // Close the codec context before tearing down CUDA/EGL so NVENC releases
+    // its references to our hardware frames context first.
+    if (m_avCodecContext) {
+        avcodec_free_context(&m_avCodecContext);
+    }
+
+    if (m_packet) {
+        av_packet_free(&m_packet);
+    }
+
+    m_fastDownloader.reset();
+    cleanupGpuPath();
+
+    if (m_swBufferPool) {
+        av_buffer_pool_uninit(&m_swBufferPool);
+    }
+}
+
+void H264NvencEncoder::cleanupGpuPath()
+{
+    if (!m_gpu) {
+        return;
+    }
+
+    {
+        std::lock_guard<std::mutex> lock(m_gpu->queueMutex);
+        while (!m_gpu->frameQueue.empty()) {
+            AVFrame *frame = m_gpu->frameQueue.front();
+            m_gpu->frameQueue.pop_front();
+            av_frame_free(&frame);
+        }
+        for (AVFrame *frame : m_gpu->freeFrames) {
+            av_frame_free(&frame);
+        }
+        m_gpu->freeFrames.clear();
+    }
+
+    const auto &cuda = CudaApi::instance();
+    const bool haveContext = (m_gpu->eglDisplay != EGL_NO_DISPLAY && m_gpu->eglContext != EGL_NO_CONTEXT);
+    const bool madeCurrent = haveContext && eglMakeCurrent(m_gpu->eglDisplay, EGL_NO_SURFACE, EGL_NO_SURFACE, m_gpu->eglContext);
+
+    if (m_gpu->cudaDeviceCtx && cuda.loaded && (m_gpu->yCudaRes || m_gpu->uvCudaRes)) {
+        auto *devCtx = reinterpret_cast<AVHWDeviceContext *>(m_gpu->cudaDeviceCtx->data);
+        auto *cuCtx = reinterpret_cast<AvCudaDeviceContext *>(devCtx->hwctx);
+        if (cuda.ctxPushCurrent(cuCtx->cuda_ctx) == kCudaSuccess) {
+            if (m_gpu->yCudaRes) {
+                cuda.graphicsUnregisterResource(m_gpu->yCudaRes);
+                m_gpu->yCudaRes = nullptr;
+            }
+            if (m_gpu->uvCudaRes) {
+                cuda.graphicsUnregisterResource(m_gpu->uvCudaRes);
+                m_gpu->uvCudaRes = nullptr;
+            }
+            CUcontext popped = nullptr;
+            cuda.ctxPopCurrent(&popped);
+        }
+    }
+
+    if (madeCurrent) {
+        if (m_gpu->fboY) {
+            glDeleteFramebuffers(1, &m_gpu->fboY);
+        }
+        if (m_gpu->fboUV) {
+            glDeleteFramebuffers(1, &m_gpu->fboUV);
+        }
+        if (m_gpu->srcTex) {
+            glDeleteTextures(1, &m_gpu->srcTex);
+        }
+        if (m_gpu->shmTex) {
+            glDeleteTextures(1, &m_gpu->shmTex);
+        }
+        if (m_gpu->yTex) {
+            glDeleteTextures(1, &m_gpu->yTex);
+        }
+        if (m_gpu->uvTex) {
+            glDeleteTextures(1, &m_gpu->uvTex);
+        }
+        if (m_gpu->progCompute) {
+            glDeleteProgram(m_gpu->progCompute);
+        }
+        if (m_gpu->progY) {
+            glDeleteProgram(m_gpu->progY);
+        }
+        if (m_gpu->progUV) {
+            glDeleteProgram(m_gpu->progUV);
+        }
+        if (m_gpu->vao) {
+            glDeleteVertexArrays(1, &m_gpu->vao);
+        }
+        eglMakeCurrent(m_gpu->eglDisplay, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+    }
+
+    if (m_gpu->eglDisplay != EGL_NO_DISPLAY) {
+        for (const auto &entry : m_gpu->eglImageCache) {
+            if (entry.image != EGL_NO_IMAGE_KHR) {
+                eglDestroyImageKHR(m_gpu->eglDisplay, entry.image);
+            }
+        }
+        m_gpu->eglImageCache.clear();
+        if (m_gpu->eglContext != EGL_NO_CONTEXT) {
+            eglDestroyContext(m_gpu->eglDisplay, m_gpu->eglContext);
+        }
+        eglTerminate(m_gpu->eglDisplay);
+    }
+
+    if (m_gpu->cudaFramesCtx) {
+        av_buffer_unref(&m_gpu->cudaFramesCtx);
+    }
+    if (m_gpu->cudaDeviceCtx) {
+        av_buffer_unref(&m_gpu->cudaDeviceCtx);
+    }
+    if (m_gpu->gbmDevice) {
+        gbm_device_destroy(m_gpu->gbmDevice);
+    }
+    if (m_gpu->drmFd >= 0) {
+        close(m_gpu->drmFd);
+    }
+
+    m_gpu.reset();
+}
+
+bool H264NvencEncoder::initializeGpuPath(const QSize &size)
+{
+    if (qEnvironmentVariableIntValue("KPIPEWIRE_NVENC_NO_ZEROCOPY") != 0) {
+        return false;
+    }
+
+    const auto &cuda = CudaApi::instance();
+    if (!cuda.loaded) {
+        qCDebug(PIPEWIRERECORD_LOGGING) << "NVENC zero-copy disabled: libcuda.so.1 interop symbols unavailable";
+        return false;
+    }
+
+    const QList<QByteArray> nodes = findCandidateRenderNodes();
+    if (nodes.isEmpty()) {
+        return false;
+    }
+
+    const int codedW = (size.width() + 1) & ~1;
+    const int codedH = (size.height() + 1) & ~1;
+
+    // Find a DRM render node backed by a CUDA-capable NVIDIA EGL context.
+    int cudaDeviceIndex = -1;
+    auto gpu = std::make_unique<GpuState>();
+    gpu->srcSize = size;
+    gpu->codedSize = QSize(codedW, codedH);
+
+    for (const QByteArray &nodePath : nodes) {
+        int fd = open(nodePath.constData(), O_RDWR | O_CLOEXEC);
+        if (fd < 0) {
+            continue;
+        }
+        gbm_device *gbm = gbm_create_device(fd);
+        if (!gbm) {
+            close(fd);
+            continue;
+        }
+
+        EGLDisplay dpy = eglGetPlatformDisplayEXT(EGL_PLATFORM_GBM_MESA, gbm, nullptr);
+        EGLint major = 0;
+        EGLint minor = 0;
+        if (dpy == EGL_NO_DISPLAY || !eglInitialize(dpy, &major, &minor)) {
+            if (dpy != EGL_NO_DISPLAY) {
+                eglTerminate(dpy);
+            }
+            gbm_device_destroy(gbm);
+            close(fd);
+            continue;
+        }
+
+        if (!eglBindAPI(EGL_OPENGL_API)) {
+            eglTerminate(dpy);
+            gbm_device_destroy(gbm);
+            close(fd);
+            continue;
+        }
+
+        static constexpr EGLint cfgAttribs[] = {
+            EGL_RENDERABLE_TYPE, EGL_OPENGL_BIT,
+            EGL_NONE,
+        };
+        EGLConfig cfg = nullptr;
+        EGLint cfgCount = 0;
+        if (!eglChooseConfig(dpy, cfgAttribs, &cfg, 1, &cfgCount) || cfgCount < 1) {
+            eglTerminate(dpy);
+            gbm_device_destroy(gbm);
+            close(fd);
+            continue;
+        }
+
+        static constexpr EGLint ctxAttribs43[] = {
+            EGL_CONTEXT_MAJOR_VERSION, 4,
+            EGL_CONTEXT_MINOR_VERSION, 3,
+            EGL_CONTEXT_OPENGL_PROFILE_MASK, EGL_CONTEXT_OPENGL_CORE_PROFILE_BIT,
+            EGL_NONE,
+        };
+        static constexpr EGLint ctxAttribs33[] = {
+            EGL_CONTEXT_MAJOR_VERSION, 3,
+            EGL_CONTEXT_MINOR_VERSION, 3,
+            EGL_CONTEXT_OPENGL_PROFILE_MASK, EGL_CONTEXT_OPENGL_CORE_PROFILE_BIT,
+            EGL_NONE,
+        };
+        bool isGl43 = true;
+        EGLContext ctx = eglCreateContext(dpy, cfg, EGL_NO_CONTEXT, ctxAttribs43);
+        if (ctx == EGL_NO_CONTEXT) {
+            isGl43 = false;
+            ctx = eglCreateContext(dpy, cfg, EGL_NO_CONTEXT, ctxAttribs33);
+        }
+        if (ctx == EGL_NO_CONTEXT || !eglMakeCurrent(dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, ctx)) {
+            if (ctx != EGL_NO_CONTEXT) {
+                eglDestroyContext(dpy, ctx);
+            }
+            eglTerminate(dpy);
+            gbm_device_destroy(gbm);
+            close(fd);
+            continue;
+        }
+
+        // Create FFmpeg's CUDA device context on the GPU matching this GL context.
+        AVBufferRef *probeDev = nullptr;
+        int matchedDev = -1;
+        if (av_hwdevice_ctx_create(&probeDev, AV_HWDEVICE_TYPE_CUDA, "0", nullptr, kAvCudaUsePrimaryContext) == 0) {
+            auto *devCtx = reinterpret_cast<AVHWDeviceContext *>(probeDev->data);
+            auto *cuCtx = reinterpret_cast<AvCudaDeviceContext *>(devCtx->hwctx);
+            if (cuda.ctxPushCurrent(cuCtx->cuda_ctx) == kCudaSuccess) {
+                unsigned int glDevCount = 0;
+                int glDevs[4] = {};
+                if (cuda.glGetDevices(&glDevCount, glDevs, 4, kCuGlDeviceListAll) == kCudaSuccess && glDevCount > 0) {
+                    matchedDev = glDevs[0];
+                }
+                CUcontext popped = nullptr;
+                cuda.ctxPopCurrent(&popped);
+            }
+            if (matchedDev == 0) {
+                gpu->cudaDeviceCtx = probeDev;
+                probeDev = nullptr;
+            } else {
+                av_buffer_unref(&probeDev);
+            }
+        }
+
+        if (matchedDev < 0) {
+            eglMakeCurrent(dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+            eglDestroyContext(dpy, ctx);
+            eglTerminate(dpy);
+            gbm_device_destroy(gbm);
+            close(fd);
+            continue;
+        }
+
+        if (!gpu->cudaDeviceCtx) {
+            const QByteArray devId = QByteArray::number(matchedDev);
+            if (av_hwdevice_ctx_create(&gpu->cudaDeviceCtx, AV_HWDEVICE_TYPE_CUDA, devId.constData(), nullptr, kAvCudaUsePrimaryContext) < 0) {
+                eglMakeCurrent(dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+                eglDestroyContext(dpy, ctx);
+                eglTerminate(dpy);
+                gbm_device_destroy(gbm);
+                close(fd);
+                continue;
+            }
+        }
+
+        cudaDeviceIndex = matchedDev;
+        gpu->renderNodePath = nodePath;
+        gpu->drmFd = fd;
+        gpu->gbmDevice = gbm;
+        gpu->eglDisplay = dpy;
+        gpu->eglContext = ctx;
+        gpu->hasDmaBufImport = epoxy_has_egl_extension(dpy, "EGL_EXT_image_dma_buf_import");
+        gpu->hasDmaBufModifiers = epoxy_has_egl_extension(dpy, "EGL_EXT_image_dma_buf_import_modifiers");
+        gpu->useCompute = isGl43;
+        break;
+    }
+
+    if (cudaDeviceIndex < 0) {
+        return false;
+    }
+
+    m_gpu = std::move(gpu);
+
+    m_gpu->cudaFramesCtx = av_hwframe_ctx_alloc(m_gpu->cudaDeviceCtx);
+    if (!m_gpu->cudaFramesCtx) {
+        cleanupGpuPath();
+        return false;
+    }
+
+    auto *framesCtx = reinterpret_cast<AVHWFramesContext *>(m_gpu->cudaFramesCtx->data);
+    framesCtx->format = AV_PIX_FMT_CUDA;
+    framesCtx->sw_format = AV_PIX_FMT_NV12;
+    framesCtx->width = codedW;
+    framesCtx->height = codedH;
+    framesCtx->initial_pool_size = 8;
+
+    if (int err = av_hwframe_ctx_init(m_gpu->cudaFramesCtx); err < 0) {
+        qCWarning(PIPEWIRERECORD_LOGGING) << "NVENC failed initializing CUDA frames context:" << av_err2str(err);
+        cleanupGpuPath();
+        return false;
+    }
+
+    // Set up persistent GL objects and BT.709 RGB->NV12 shader(s).
+    glDisable(GL_DEPTH_TEST);
+    glDisable(GL_STENCIL_TEST);
+    glDisable(GL_BLEND);
+    glDisable(GL_CULL_FACE);
+    glDisable(GL_SCISSOR_TEST);
+
+    glGenTextures(1, &m_gpu->srcTex);
+    glBindTexture(GL_TEXTURE_2D, m_gpu->srcTex);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+
+    glGenTextures(1, &m_gpu->shmTex);
+    glBindTexture(GL_TEXTURE_2D, m_gpu->shmTex);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+
+    if (m_gpu->useCompute) {
+        m_gpu->progCompute = linkComputeProgram(kComputeNv12Src);
+        if (m_gpu->progCompute) {
+            m_gpu->csLocSrc = glGetUniformLocation(m_gpu->progCompute, "uSrc");
+            m_gpu->csLocSrcSize = glGetUniformLocation(m_gpu->progCompute, "uSrcSize");
+            m_gpu->csLocCodedSize = glGetUniformLocation(m_gpu->progCompute, "uCodedSize");
+            m_gpu->csLocFullRange = glGetUniformLocation(m_gpu->progCompute, "uFullRange");
+        } else {
+            m_gpu->useCompute = false;
+        }
+    }
+
+    glGenTextures(1, &m_gpu->yTex);
+    glBindTexture(GL_TEXTURE_2D, m_gpu->yTex);
+    if (m_gpu->useCompute) {
+        glTexStorage2D(GL_TEXTURE_2D, 1, GL_R8, codedW, codedH);
+    } else {
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_R8, codedW, codedH, 0, GL_RED, GL_UNSIGNED_BYTE, nullptr);
+    }
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+
+    glGenTextures(1, &m_gpu->uvTex);
+    glBindTexture(GL_TEXTURE_2D, m_gpu->uvTex);
+    if (m_gpu->useCompute) {
+        glTexStorage2D(GL_TEXTURE_2D, 1, GL_RG8, codedW / 2, codedH / 2);
+    } else {
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RG8, codedW / 2, codedH / 2, 0, GL_RG, GL_UNSIGNED_BYTE, nullptr);
+    }
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glBindTexture(GL_TEXTURE_2D, 0);
+
+    if (!m_gpu->useCompute) {
+        glGenVertexArrays(1, &m_gpu->vao);
+        m_gpu->progY = linkProgram(kVertexShaderSrc, kFragYSrc);
+        m_gpu->progUV = linkProgram(kVertexShaderSrc, kFragUVSrc);
+        if (!m_gpu->vao || !m_gpu->progY || !m_gpu->progUV) {
+            cleanupGpuPath();
+            return false;
+        }
+
+        m_gpu->yLocSrc = glGetUniformLocation(m_gpu->progY, "uSrc");
+        m_gpu->yLocSrcSize = glGetUniformLocation(m_gpu->progY, "uSrcSize");
+        m_gpu->yLocFullRange = glGetUniformLocation(m_gpu->progY, "uFullRange");
+        m_gpu->uvLocSrc = glGetUniformLocation(m_gpu->progUV, "uSrc");
+        m_gpu->uvLocSrcSize = glGetUniformLocation(m_gpu->progUV, "uSrcSize");
+        m_gpu->uvLocFullRange = glGetUniformLocation(m_gpu->progUV, "uFullRange");
+
+        glGenFramebuffers(1, &m_gpu->fboY);
+        glBindFramebuffer(GL_FRAMEBUFFER, m_gpu->fboY);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, m_gpu->yTex, 0);
+        const bool fboYOk = (glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE);
+
+        glGenFramebuffers(1, &m_gpu->fboUV);
+        glBindFramebuffer(GL_FRAMEBUFFER, m_gpu->fboUV);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, m_gpu->uvTex, 0);
+        const bool fboUVOk = (glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE);
+        glBindFramebuffer(GL_FRAMEBUFFER, 0);
+
+        if (!fboYOk || !fboUVOk) {
+            qCWarning(PIPEWIRERECORD_LOGGING) << "NVENC GL NV12 framebuffers incomplete";
+            cleanupGpuPath();
+            return false;
+        }
+    }
+
+    // Register Y and UV output textures once with CUDA.
+    auto *devCtx = reinterpret_cast<AVHWDeviceContext *>(m_gpu->cudaDeviceCtx->data);
+    auto *cuCtx = reinterpret_cast<AvCudaDeviceContext *>(devCtx->hwctx);
+    if (cuda.ctxPushCurrent(cuCtx->cuda_ctx) != kCudaSuccess) {
+        cleanupGpuPath();
+        return false;
+    }
+
+    const CUresult crY = cuda.graphicsGLRegisterImage(&m_gpu->yCudaRes, m_gpu->yTex, GL_TEXTURE_2D, kCuGraphicsRegisterFlagsReadOnly);
+    const CUresult crUV = cuda.graphicsGLRegisterImage(&m_gpu->uvCudaRes, m_gpu->uvTex, GL_TEXTURE_2D, kCuGraphicsRegisterFlagsReadOnly);
+
+    CUcontext popped = nullptr;
+    cuda.ctxPopCurrent(&popped);
+
+    if (crY != kCudaSuccess || crUV != kCudaSuccess) {
+        qCWarning(PIPEWIRERECORD_LOGGING) << "NVENC CUDA-GL texture registration failed:" << crY << crUV;
+        cleanupGpuPath();
+        return false;
+    }
+
+    qCInfo(PIPEWIRERECORD_LOGGING) << "H264NvencEncoder using zero-copy GPU DMA-BUF -> GL"
+                                   << (m_gpu->useCompute ? "(compute)" : "(fragment)") << "-> CUDA path on CUDA device" << cudaDeviceIndex;
+    return true;
+}
+
+bool H264NvencEncoder::initialize(const QSize &size)
+{
+    Q_ASSERT(!size.isEmpty());
+
+    auto codec = avcodec_find_encoder_by_name("h264_nvenc");
+    if (!codec) {
+        qCWarning(PIPEWIRERECORD_LOGGING) << "h264_nvenc codec not found";
+        return false;
+    }
+
+    const bool useGpu = initializeGpuPath(size);
+    if (!useGpu) {
+        // Fallback software path: single-pass BT.709 NV12 conversion (and only pad odd dimensions).
+        const auto colorRange = m_colorRange == PipeWireBaseEncodedStream::ColorRange::Full ? u"full"_s : u"limited"_s;
+        const bool needsPad = (size.width() & 1) || (size.height() & 1);
+        if (needsPad) {
+            m_filterGraphToParse =
+                u"scale=out_range=%1:out_color_matrix=bt709:flags=fast_bilinear,format=nv12,pad=ceil(iw/2)*2:ceil(ih/2)*2"_s.arg(colorRange);
+        } else {
+            m_filterGraphToParse = u"scale=out_range=%1:out_color_matrix=bt709:flags=fast_bilinear,format=nv12"_s.arg(colorRange);
+        }
+
+        if (!createFilterGraph(size)) {
+            return false;
+        }
+
+        m_swPoolSize = size;
+        // DmaBufHandler::downloadFrame() uses glReadPixels without GL_PACK_ROW_LENGTH,
+        // so the buffer must be tightly packed (width * 4 bytes per row).
+        const int stride = size.width() * 4;
+        m_swBufferPool = av_buffer_pool_init(static_cast<size_t>(stride) * static_cast<size_t>(size.height()), nullptr);
+    }
+
+    m_avCodecContext = avcodec_alloc_context3(codec);
+    if (!m_avCodecContext) {
+        qCWarning(PIPEWIRERECORD_LOGGING) << "Could not allocate video codec context";
+        cleanupGpuPath();
+        return false;
+    }
+
+    const int codedW = (size.width() + 1) & ~1;
+    const int codedH = (size.height() + 1) & ~1;
+    m_avCodecContext->width = codedW;
+    m_avCodecContext->height = codedH;
+    m_avCodecContext->max_b_frames = 0;
+
+    int gopSize = 100;
+    if (qEnvironmentVariableIsSet("KPIPEWIRE_NVENC_GOP")) {
+        bool ok = false;
+        const int envGop = qEnvironmentVariableIntValue("KPIPEWIRE_NVENC_GOP", &ok);
+        if (ok && envGop >= 1) {
+            gopSize = envGop;
+        }
+    }
+    m_avCodecContext->gop_size = gopSize;
+    m_avCodecContext->time_base = AVRational{1, 1000};
+    m_avCodecContext->color_range = m_colorRange == PipeWireBaseEncodedStream::ColorRange::Full ? AVCOL_RANGE_JPEG : AVCOL_RANGE_MPEG;
+    m_avCodecContext->colorspace = AVCOL_SPC_BT709;
+    m_avCodecContext->color_primaries = AVCOL_PRI_BT709;
+    m_avCodecContext->color_trc = AVCOL_TRC_BT709;
+
+    m_configuredMaxRate = parseBitrateEnv("KPIPEWIRE_NVENC_MAXRATE");
+    if (m_configuredMaxRate > 0) {
+        m_avCodecContext->rc_max_rate = m_configuredMaxRate;
+        m_avCodecContext->rc_buffer_size = static_cast<int>(std::clamp<int64_t>(m_configuredMaxRate / 2, 250000, 100000000));
+    }
+
+    if (useGpu) {
+        m_avCodecContext->pix_fmt = AV_PIX_FMT_CUDA;
+        m_avCodecContext->sw_pix_fmt = AV_PIX_FMT_NV12;
+        m_avCodecContext->hw_frames_ctx = av_buffer_ref(m_gpu->cudaFramesCtx);
+    } else {
+        m_avCodecContext->pix_fmt = AV_PIX_FMT_NV12;
+    }
+
+    // Without a frame rate NVENC assumes 1/time_base, i.e. 1000 fps, and signals an
+    // unreasonably high level: give it the stream's real maximum frame rate.
+    const Fraction framerate = m_produce->maxFramerate();
+    if (framerate.numerator > 0 && framerate.denominator > 0) {
+        m_avCodecContext->framerate = AVRational{int(framerate.numerator), int(framerate.denominator)};
+    }
+
+    switch (m_profile) {
+    case H264Profile::Baseline:
+        m_avCodecContext->profile = AV_PROFILE_H264_BASELINE;
+        break;
+    case H264Profile::Main:
+        m_avCodecContext->profile = AV_PROFILE_H264_MAIN;
+        break;
+    case H264Profile::High:
+        m_avCodecContext->profile = AV_PROFILE_H264_HIGH;
+        break;
+    }
+
+    AVDictionary *options = buildEncodingOptions();
+    maybeLogOptions(options);
+
+    const int result = avcodec_open2(m_avCodecContext, codec, &options);
+    av_dict_free(&options);
+    if (result < 0) {
+        qCWarning(PIPEWIRERECORD_LOGGING) << "Could not open h264_nvenc codec" << av_err2str(result);
+        avcodec_free_context(&m_avCodecContext);
+        cleanupGpuPath();
+        return false;
+    }
+
+    m_packet = av_packet_alloc();
+    if (!m_packet) {
+        qCWarning(PIPEWIRERECORD_LOGGING) << "Could not allocate AVPacket for h264_nvenc";
+        avcodec_free_context(&m_avCodecContext);
+        cleanupGpuPath();
+        return false;
+    }
+
+    m_codecOpen = true;
+    return true;
+}
+
+bool H264NvencEncoder::uploadImageToShmTexture(const void *data, int width, int height, int stride, spa_video_format format)
+{
+    GLenum glFormat = GL_RGBA;
+    int bpp = 4;
+
+    switch (format) {
+    case SPA_VIDEO_FORMAT_RGBA:
+    case SPA_VIDEO_FORMAT_RGBx:
+        glFormat = GL_RGBA;
+        bpp = 4;
+        break;
+    case SPA_VIDEO_FORMAT_BGRA:
+    case SPA_VIDEO_FORMAT_BGRx:
+        glFormat = GL_BGRA;
+        bpp = 4;
+        break;
+    case SPA_VIDEO_FORMAT_RGB:
+        glFormat = GL_RGB;
+        bpp = 3;
+        break;
+    case SPA_VIDEO_FORMAT_BGR:
+        glFormat = GL_BGR;
+        bpp = 3;
+        break;
+    default:
+        return false;
+    }
+
+    const int rowPixels = stride / bpp;
+    if (rowPixels < width || (stride % bpp) != 0) {
+        return false;
+    }
+
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, m_gpu->shmTex);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, (bpp == 4) ? 4 : 1);
+    glPixelStorei(GL_UNPACK_ROW_LENGTH, rowPixels);
+
+    if (!m_gpu->shmTexAllocated) {
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, width, height, 0, glFormat, GL_UNSIGNED_BYTE, data);
+        m_gpu->shmTexAllocated = true;
+    } else {
+        glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, width, height, glFormat, GL_UNSIGNED_BYTE, data);
+    }
+
+    glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+    return true;
+}
+
+bool H264NvencEncoder::filterFrameGpu(const PipeWireFrame &frame)
+{
+    if (eglGetCurrentContext() != m_gpu->eglContext) {
+        if (!eglMakeCurrent(m_gpu->eglDisplay, EGL_NO_SURFACE, EGL_NO_SURFACE, m_gpu->eglContext)) {
+            qCWarning(PIPEWIRERECORD_LOGGING) << "NVENC failed to bind EGL context";
+            return false;
+        }
+    }
+
+    EGLImageKHR eglImage = EGL_NO_IMAGE_KHR;
+    bool eglImageCached = false;
+    GLuint activeSrcTex = 0;
+
+    if (frame.dmabuf) {
+        const auto &dmabuf = *frame.dmabuf;
+        if (dmabuf.width != m_gpu->srcSize.width() || dmabuf.height != m_gpu->srcSize.height() || dmabuf.planes.isEmpty()) {
+            return false;
+        }
+
+        if (m_gpu->hasDmaBufImport && !m_gpu->directDmaBufFailed) {
+            const uint32_t drmFormat = dmabuf.format ? dmabuf.format : PipeWireSourceStream::spaVideoFormatToDrmFormat(frame.format);
+            bool cacheHit = false;
+            eglImage = importDmaBufEglImage(m_gpu->eglDisplay,
+                                            m_gpu->hasDmaBufModifiers,
+                                            m_gpu->eglImageCache,
+                                            dmabuf,
+                                            drmFormat,
+                                            eglImageCached,
+                                            cacheHit);
+            if (eglImage != EGL_NO_IMAGE_KHR) {
+                if (PIPEWIRERECORDFRAMESTATS_LOGGING().isDebugEnabled()) {
+                    m_stats->eglCacheTotal.fetch_add(1, std::memory_order_relaxed);
+                    if (cacheHit) {
+                        m_stats->eglCacheHits.fetch_add(1, std::memory_order_relaxed);
+                    }
+                }
+                glActiveTexture(GL_TEXTURE0);
+                glBindTexture(GL_TEXTURE_2D, m_gpu->srcTex);
+                glEGLImageTargetTexture2DOES(GL_TEXTURE_2D, eglImage);
+                activeSrcTex = m_gpu->srcTex;
+            }
+        }
+
+        if (activeSrcTex == 0) {
+            // Hybrid multi-GPU fallback (e.g. Intel compositor DMA-BUF + NVIDIA NVENC):
+            // prefer our non-debug, cached GL_BGRA downloader (avoids R<->B swizzle and
+            // per-frame FBO/texture churn), falling back to DmaBufHandler if needed.
+            if (!m_fastDownloader) {
+                m_fastDownloader = std::make_unique<FastDmaBufDownloader>();
+            }
+            const size_t byteCount = static_cast<size_t>(m_gpu->srcSize.width()) * static_cast<size_t>(m_gpu->srcSize.height()) * 4;
+            if (m_gpu->fallbackPixels.size() != byteCount) {
+                m_gpu->fallbackPixels.resize(byteCount);
+            }
+
+            bool downloadedBgra = m_fastDownloader->download(m_gpu->fallbackPixels.data(), GL_BGRA, frame, m_gpu->renderNodePath);
+            bool downloadedRgba = false;
+            if (!downloadedBgra) {
+                if (m_gpu->fallbackImage.size() != m_gpu->srcSize) {
+                    m_gpu->fallbackImage = QImage(m_gpu->srcSize, QImage::Format_RGBA8888_Premultiplied);
+                }
+                downloadedRgba = m_dmaBufHandler.downloadFrame(m_gpu->fallbackImage, frame);
+            }
+            if (!downloadedBgra && !downloadedRgba) {
+                m_produce->m_stream->renegotiateModifierFailed(frame.format, dmabuf.modifier);
+                return false;
+            }
+            if (!m_gpu->directDmaBufFailed) {
+                qCWarning(PIPEWIRERECORD_LOGGING) << "NVENC direct DMA-BUF EGL import failed (modifier" << Qt::hex << dmabuf.modifier << "), using"
+                                                  << (downloadedBgra ? "fast BGRA" : "DmaBufHandler") << "+ GPU NV12 fallback";
+                m_gpu->directDmaBufFailed = true;
+            }
+            // The downloader bound its own EGL context; restore ours before uploading.
+            if (!eglMakeCurrent(m_gpu->eglDisplay, EGL_NO_SURFACE, EGL_NO_SURFACE, m_gpu->eglContext)) {
+                return false;
+            }
+            const bool uploaded = downloadedBgra
+                ? uploadImageToShmTexture(m_gpu->fallbackPixels.data(),
+                                          m_gpu->srcSize.width(),
+                                          m_gpu->srcSize.height(),
+                                          m_gpu->srcSize.width() * 4,
+                                          SPA_VIDEO_FORMAT_BGRA)
+                : uploadImageToShmTexture(m_gpu->fallbackImage.constBits(),
+                                          m_gpu->fallbackImage.width(),
+                                          m_gpu->fallbackImage.height(),
+                                          static_cast<int>(m_gpu->fallbackImage.bytesPerLine()),
+                                          SPA_VIDEO_FORMAT_RGBA);
+            if (!uploaded) {
+                return false;
+            }
+            activeSrcTex = m_gpu->shmTex;
+        }
+    } else if (frame.dataFrame) {
+        const auto &df = *frame.dataFrame;
+        if (df.size != m_gpu->srcSize || !df.data) {
+            return false;
+        }
+        if (!uploadImageToShmTexture(df.data, df.size.width(), df.size.height(), df.stride, df.format)) {
+            QImage rgba = df.toImage().convertToFormat(QImage::Format_RGBA8888);
+            if (!uploadImageToShmTexture(rgba.constBits(),
+                                         rgba.width(),
+                                         rgba.height(),
+                                         static_cast<int>(rgba.bytesPerLine()),
+                                         SPA_VIDEO_FORMAT_RGBA)) {
+                return false;
+            }
+        }
+        activeSrcTex = m_gpu->shmTex;
+    } else {
+        return false;
+    }
+
+    const int fullRange = (m_colorRange == PipeWireBaseEncodedStream::ColorRange::Full) ? 1 : 0;
+    const int srcW = m_gpu->srcSize.width();
+    const int srcH = m_gpu->srcSize.height();
+    const int codedW = m_gpu->codedSize.width();
+    const int codedH = m_gpu->codedSize.height();
+
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, activeSrcTex);
+
+    if (m_gpu->useCompute) {
+        // Single-pass compute shader: reads the RGB source once per 2x2 block
+        // and writes both Y (GL_R8) and interleaved UV (GL_RG8).
+        glUseProgram(m_gpu->progCompute);
+        glUniform1i(m_gpu->csLocSrc, 0);
+        glUniform2i(m_gpu->csLocSrcSize, srcW, srcH);
+        glUniform2i(m_gpu->csLocCodedSize, codedW, codedH);
+        glUniform1i(m_gpu->csLocFullRange, fullRange);
+        glBindImageTexture(0, m_gpu->yTex, 0, GL_FALSE, 0, GL_WRITE_ONLY, GL_R8);
+        glBindImageTexture(1, m_gpu->uvTex, 0, GL_FALSE, 0, GL_WRITE_ONLY, GL_RG8);
+        glDispatchCompute(static_cast<GLuint>((codedW / 2 + 15) / 16), static_cast<GLuint>((codedH / 2 + 15) / 16), 1);
+        glMemoryBarrier(GL_SHADER_IMAGE_ACCESS_BARRIER_BIT | GL_TEXTURE_UPDATE_BARRIER_BIT);
+    } else {
+        glBindVertexArray(m_gpu->vao);
+
+        // Pass 1: Y plane (GL_R8, codedW x codedH)
+        glBindFramebuffer(GL_FRAMEBUFFER, m_gpu->fboY);
+        glViewport(0, 0, codedW, codedH);
+        glUseProgram(m_gpu->progY);
+        glUniform1i(m_gpu->yLocSrc, 0);
+        glUniform2i(m_gpu->yLocSrcSize, srcW, srcH);
+        glUniform1i(m_gpu->yLocFullRange, fullRange);
+        glDrawArrays(GL_TRIANGLES, 0, 3);
+
+        // Pass 2: interleaved UV plane (GL_RG8, codedW/2 x codedH/2)
+        glBindFramebuffer(GL_FRAMEBUFFER, m_gpu->fboUV);
+        glViewport(0, 0, codedW / 2, codedH / 2);
+        glUseProgram(m_gpu->progUV);
+        glUniform1i(m_gpu->uvLocSrc, 0);
+        glUniform2i(m_gpu->uvLocSrcSize, srcW, srcH);
+        glUniform1i(m_gpu->uvLocFullRange, fullRange);
+        glDrawArrays(GL_TRIANGLES, 0, 3);
+
+        glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    }
+
+    using Clock = std::chrono::steady_clock;
+    const bool trackGpuTiming = PIPEWIRERECORDFRAMESTATS_LOGGING().isDebugEnabled();
+    const auto timingStart = [trackGpuTiming] {
+        return trackGpuTiming ? Clock::now() : Clock::time_point{};
+    };
+    const auto elapsedMs = [trackGpuTiming](Clock::time_point start) {
+        return trackGpuTiming ? std::chrono::duration<double, std::milli>(Clock::now() - start).count() : 0.0;
+    };
+    double fenceWaitMs = 0.0;
+    if (eglImage != EGL_NO_IMAGE_KHR) {
+        // Ensure GL has finished sampling the PipeWire DMA-BUF before returning it.
+        GLsync fence = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+        const auto waitStart = timingStart();
+        const GLenum waitResult = fence ? glClientWaitSync(fence, GL_SYNC_FLUSH_COMMANDS_BIT, 1000000000ULL) : GL_WAIT_FAILED;
+        if (waitResult != GL_ALREADY_SIGNALED && waitResult != GL_CONDITION_SATISFIED) {
+            glFinish();
+        }
+        fenceWaitMs = elapsedMs(waitStart);
+        if (fence) {
+            glDeleteSync(fence);
+        }
+        if (!eglImageCached) {
+            eglDestroyImageKHR(m_gpu->eglDisplay, eglImage);
+        }
+    } else {
+        glFlush();
+    }
+
+    AVFrame *cudaFrame = nullptr;
+    {
+        std::lock_guard<std::mutex> lock(m_gpu->queueMutex);
+        if (!m_gpu->freeFrames.empty()) {
+            cudaFrame = m_gpu->freeFrames.back();
+            m_gpu->freeFrames.pop_back();
+        }
+    }
+    if (!cudaFrame) {
+        cudaFrame = av_frame_alloc();
+    }
+    if (!cudaFrame) {
+        return false;
+    }
+    if (int err = av_hwframe_get_buffer(m_gpu->cudaFramesCtx, cudaFrame, 0); err < 0) {
+        qCWarning(PIPEWIRERECORD_LOGGING) << "NVENC failed to allocate CUDA frame:" << av_err2str(err);
+        av_frame_free(&cudaFrame);
+        return false;
+    }
+
+    cudaFrame->color_range = m_avCodecContext->color_range;
+    cudaFrame->colorspace = m_avCodecContext->colorspace;
+    cudaFrame->color_primaries = m_avCodecContext->color_primaries;
+    cudaFrame->color_trc = m_avCodecContext->color_trc;
+    if (frame.presentationTimestamp) {
+        cudaFrame->pts = m_produce->framePts(frame.presentationTimestamp);
+    }
+
+    // VRAM-to-VRAM copy from GL Y/UV textures into the pooled CUDA NV12 frame.
+    const auto &cuda = CudaApi::instance();
+    auto *devCtx = reinterpret_cast<AVHWDeviceContext *>(m_gpu->cudaDeviceCtx->data);
+    auto *cuCtx = reinterpret_cast<AvCudaDeviceContext *>(devCtx->hwctx);
+
+    bool copyOk = false;
+    double cudaMapMs = 0.0;
+    double cudaUnmapMs = 0.0;
+    if (cuda.ctxPushCurrent(cuCtx->cuda_ctx) == kCudaSuccess) {
+        CUgraphicsResource resources[2] = {m_gpu->yCudaRes, m_gpu->uvCudaRes};
+        const auto mapStart = timingStart();
+        const CUresult mapResult = cuda.graphicsMapResources(2, resources, cuCtx->stream);
+        cudaMapMs = elapsedMs(mapStart);
+        if (mapResult == kCudaSuccess) {
+            CUarray yArr = nullptr;
+            CUarray uvArr = nullptr;
+            if (cuda.graphicsSubResourceGetMappedArray(&yArr, m_gpu->yCudaRes, 0, 0) == kCudaSuccess
+                && cuda.graphicsSubResourceGetMappedArray(&uvArr, m_gpu->uvCudaRes, 0, 0) == kCudaSuccess) {
+                CudaMemcpy2D cpY{};
+                cpY.srcMemoryType = kCuMemoryTypeArray;
+                cpY.srcArray = yArr;
+                cpY.dstMemoryType = kCuMemoryTypeDevice;
+                cpY.dstDevice = reinterpret_cast<CUdeviceptr>(cudaFrame->data[0]);
+                cpY.dstPitch = static_cast<size_t>(cudaFrame->linesize[0]);
+                cpY.WidthInBytes = static_cast<size_t>(codedW);
+                cpY.Height = static_cast<size_t>(codedH);
+
+                CudaMemcpy2D cpUV{};
+                cpUV.srcMemoryType = kCuMemoryTypeArray;
+                cpUV.srcArray = uvArr;
+                cpUV.dstMemoryType = kCuMemoryTypeDevice;
+                cpUV.dstDevice = reinterpret_cast<CUdeviceptr>(cudaFrame->data[1]);
+                cpUV.dstPitch = static_cast<size_t>(cudaFrame->linesize[1]);
+                cpUV.WidthInBytes = static_cast<size_t>(codedW);
+                cpUV.Height = static_cast<size_t>(codedH / 2);
+
+                copyOk = (cuda.memcpy2DAsync(&cpY, cuCtx->stream) == kCudaSuccess)
+                    && (cuda.memcpy2DAsync(&cpUV, cuCtx->stream) == kCudaSuccess);
+            }
+            const auto unmapStart = timingStart();
+            cuda.graphicsUnmapResources(2, resources, cuCtx->stream);
+            cudaUnmapMs = elapsedMs(unmapStart);
+        }
+        CUcontext popped = nullptr;
+        cuda.ctxPopCurrent(&popped);
+    }
+
+    if (!copyOk) {
+        qCWarning(PIPEWIRERECORD_LOGGING) << "NVENC CUDA-GL copy failed";
+        av_frame_free(&cudaFrame);
+        return false;
+    }
+
+    if (trackGpuTiming) {
+        std::lock_guard<std::mutex> lock(m_stats->gpuTimingMutex);
+        // Bound samples if packet reception stalls and the reporting window stays open.
+        if (m_stats->cudaMapMs.size() < 1024) {
+            if (eglImage != EGL_NO_IMAGE_KHR) {
+                m_stats->fenceWaitMs.push_back(fenceWaitMs);
+            }
+            m_stats->cudaMapMs.push_back(cudaMapMs);
+            m_stats->cudaUnmapMs.push_back(cudaUnmapMs);
+        }
+    }
+    {
+        std::lock_guard<std::mutex> lock(m_gpu->queueMutex);
+        m_gpu->frameQueue.push_back(cudaFrame);
+    }
+    return true;
+}
+
+bool H264NvencEncoder::filterFrameSoftware(const PipeWireFrame &frame)
+{
+    const QSize size = m_produce->m_stream->size();
+    if (!frame.dmabuf || !m_swBufferPool || size != m_swPoolSize) {
+        return SoftwareEncoder::filterFrame(frame);
+    }
+
+    // Download directly into a pooled AVBuffer to avoid per-frame QImage malloc
+    // and the redundant av_image_copy performed by SoftwareEncoder::filterFrame().
+    AVBufferRef *buf = av_buffer_pool_get(m_swBufferPool);
+    if (!buf) {
+        return SoftwareEncoder::filterFrame(frame);
+    }
+
+    const int stride = size.width() * 4;
+    if (!m_fastDownloader) {
+        m_fastDownloader = std::make_unique<FastDmaBufDownloader>();
+    }
+    bool downloaded = m_fastDownloader->download(buf->data, GL_RGBA, frame, QByteArray());
+    if (!downloaded) {
+        QImage wrapped(buf->data, size.width(), size.height(), stride, QImage::Format_RGBA8888_Premultiplied);
+        downloaded = m_dmaBufHandler.downloadFrame(wrapped, frame);
+    }
+    if (!downloaded) {
+        av_buffer_unref(&buf);
+        m_produce->m_stream->renegotiateModifierFailed(frame.format, frame.dmabuf->modifier);
+        return false;
+    }
+
+    AVFrame *avFrame = av_frame_alloc();
+    if (!avFrame) {
+        av_buffer_unref(&buf);
+        return false;
+    }
+
+    avFrame->format = AV_PIX_FMT_RGBA;
+    avFrame->width = size.width();
+    avFrame->height = size.height();
+    avFrame->data[0] = buf->data;
+    avFrame->linesize[0] = stride;
+    avFrame->buf[0] = buf;
+    if (frame.presentationTimestamp) {
+        avFrame->pts = m_produce->framePts(frame.presentationTimestamp);
+    }
+
+    const int result = av_buffersrc_add_frame(m_inputFilter, avFrame);
+    av_frame_free(&avFrame);
+    if (result < 0) {
+        qCWarning(PIPEWIRERECORD_LOGGING) << "Failed to submit frame for filtering:" << av_err2str(result);
+        return false;
+    }
+
+    return true;
+}
+
+bool H264NvencEncoder::filterFrame(const PipeWireFrame &frame)
+{
+    const bool trackStats = PIPEWIRERECORDFRAMESTATS_LOGGING().isDebugEnabled();
+    const auto t0 = trackStats ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
+
+    const bool ok = m_gpu ? filterFrameGpu(frame) : filterFrameSoftware(frame);
+
+    if (trackStats && ok) {
+        const auto dtUs = std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count();
+        m_stats->filterUs.fetch_add(static_cast<uint64_t>(std::max<int64_t>(dtUs, 0)), std::memory_order_relaxed);
+        m_stats->filterCount.fetch_add(1, std::memory_order_relaxed);
+    }
+    return ok;
+}
+
+std::pair<int, int> H264NvencEncoder::encodeFrame(int maximumFrames)
+{
+    if (!m_gpu) {
+        const bool trackStats = PIPEWIRERECORDFRAMESTATS_LOGGING().isDebugEnabled();
+        const auto t0 = trackStats ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
+        auto res = SoftwareEncoder::encodeFrame(maximumFrames);
+        if (trackStats && res.second > 0) {
+            const auto dtUs = std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count();
+            m_stats->sendUs.fetch_add(static_cast<uint64_t>(std::max<int64_t>(dtUs, 0)), std::memory_order_relaxed);
+            m_stats->sendCount.fetch_add(static_cast<uint64_t>(res.second), std::memory_order_relaxed);
+        }
+        return res;
+    }
+
+    const bool trackStats = PIPEWIRERECORDFRAMESTATS_LOGGING().isDebugEnabled();
+    int filtered = 0;
+    int queued = 0;
+
+    for (;;) {
+        AVFrame *frame = nullptr;
+        {
+            std::lock_guard<std::mutex> lock(m_gpu->queueMutex);
+            if (m_gpu->frameQueue.empty()) {
+                break;
+            }
+            frame = m_gpu->frameQueue.front();
+            m_gpu->frameQueue.pop_front();
+        }
+
+        if (queued < maximumFrames) {
+            const auto t0 = trackStats ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
+            int ret = -1;
+            {
+                std::lock_guard<std::mutex> guard(m_avCodecMutex);
+                ret = avcodec_send_frame(m_avCodecContext, frame);
+            }
+            if (ret == AVERROR(EAGAIN)) {
+                // Keep the frame at the head of the queue for the next pass.
+                std::lock_guard<std::mutex> lock(m_gpu->queueMutex);
+                m_gpu->frameQueue.push_front(frame);
+                break;
+            }
+            if (trackStats && ret == 0) {
+                const auto dtUs = std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count();
+                m_stats->sendUs.fetch_add(static_cast<uint64_t>(std::max<int64_t>(dtUs, 0)), std::memory_order_relaxed);
+                m_stats->sendCount.fetch_add(1, std::memory_order_relaxed);
+            }
+            filtered++;
+            av_frame_unref(frame);
+            {
+                std::lock_guard<std::mutex> lock(m_gpu->queueMutex);
+                if (m_gpu->freeFrames.size() < 16) {
+                    m_gpu->freeFrames.push_back(frame);
+                    frame = nullptr;
+                }
+            }
+            if (frame) {
+                av_frame_free(&frame);
+            }
+            if (ret < 0) {
+                if (ret != AVERROR_EOF) {
+                    qCWarning(PIPEWIRERECORD_LOGGING) << "Error sending CUDA frame to NVENC:" << av_err2str(ret);
+                }
+                break;
+            }
+            queued++;
+        } else {
+            filtered++;
+            qCWarning(PIPEWIRERECORD_LOGGING) << "Encode queue is full, discarding frame" << frame->pts;
+            av_frame_unref(frame);
+            {
+                std::lock_guard<std::mutex> lock(m_gpu->queueMutex);
+                if (m_gpu->freeFrames.size() < 16) {
+                    m_gpu->freeFrames.push_back(frame);
+                    frame = nullptr;
+                }
+            }
+            if (frame) {
+                av_frame_free(&frame);
+            }
+        }
+    }
+
+    return std::make_pair(filtered, queued);
+}
+
+void H264NvencEncoder::maybeLogTelemetry()
+{
+    if (!PIPEWIRERECORDFRAMESTATS_LOGGING().isDebugEnabled()) {
+        return;
+    }
+
+    const auto now = std::chrono::steady_clock::now();
+    if (m_stats->windowStart.time_since_epoch().count() == 0) {
+        m_stats->windowStart = now;
+        return;
+    }
+
+    const double elapsedSec = std::chrono::duration<double>(now - m_stats->windowStart).count();
+    if (elapsedSec < 1.0) {
+        return;
+    }
+
+    const uint64_t filterUs = m_stats->filterUs.exchange(0, std::memory_order_relaxed);
+    const uint64_t filterCount = m_stats->filterCount.exchange(0, std::memory_order_relaxed);
+    const uint64_t sendUs = m_stats->sendUs.exchange(0, std::memory_order_relaxed);
+    const uint64_t sendCount = m_stats->sendCount.exchange(0, std::memory_order_relaxed);
+    const uint64_t eglHits = m_stats->eglCacheHits.exchange(0, std::memory_order_relaxed);
+    const uint64_t eglTotal = m_stats->eglCacheTotal.exchange(0, std::memory_order_relaxed);
+
+    std::vector<double> fenceWaitMs;
+    std::vector<double> cudaMapMs;
+    std::vector<double> cudaUnmapMs;
+    {
+        std::lock_guard<std::mutex> lock(m_stats->gpuTimingMutex);
+        fenceWaitMs.swap(m_stats->fenceWaitMs);
+        cudaMapMs.swap(m_stats->cudaMapMs);
+        cudaUnmapMs.swap(m_stats->cudaUnmapMs);
+    }
+    const auto p95 = [](std::vector<double> &samples) {
+        if (samples.empty()) {
+            return -1.0;
+        }
+        auto rank = samples.begin() + (samples.size() * 95 - 1) / 100;
+        std::nth_element(samples.begin(), rank, samples.end());
+        return *rank;
+    };
+
+    const uint64_t pkts = m_stats->pktCount;
+    const uint64_t keys = m_stats->keyCount;
+    const uint64_t bytes = m_stats->pktBytes;
+    const uint64_t recvUs = m_stats->recvUs;
+
+    m_stats->pktCount = 0;
+    m_stats->keyCount = 0;
+    m_stats->pktBytes = 0;
+    m_stats->recvUs = 0;
+    m_stats->windowStart = now;
+
+    const char *mode = "software";
+    if (m_gpu) {
+        if (m_gpu->directDmaBufFailed) {
+            mode = "gpu-hybrid";
+        } else if (m_gpu->useCompute) {
+            mode = "gpu-compute";
+        } else {
+            mode = "gpu-fragment";
+        }
+    }
+
+    const double fps = static_cast<double>(pkts) / elapsedSec;
+    const double filterMs = filterCount ? (static_cast<double>(filterUs) / 1000.0 / static_cast<double>(filterCount)) : 0.0;
+    const double encodeMs = (sendCount ? (static_cast<double>(sendUs) / 1000.0 / static_cast<double>(sendCount)) : 0.0)
+        + (pkts ? (static_cast<double>(recvUs) / 1000.0 / static_cast<double>(pkts)) : 0.0);
+    const double mbps = (static_cast<double>(bytes) * 8.0) / (elapsedSec * 1e6);
+    const double avgKb = pkts ? (static_cast<double>(bytes) / 1024.0 / static_cast<double>(pkts)) : 0.0;
+
+    qCDebug(PIPEWIRERECORDFRAMESTATS_LOGGING,
+            "NVENC[%s %dx%d]: %.1f fps | filter=%.2fms encode=%.2fms | %.2f Mbps (%.1f KB/f, %llu key) | eglCache=%llu/%llu"
+            " | p95 CPU ms fence=%.3f cudaMap=%.3f cudaUnmap=%.3f",
+            mode,
+            m_avCodecContext ? m_avCodecContext->width : 0,
+            m_avCodecContext ? m_avCodecContext->height : 0,
+            fps,
+            filterMs,
+            encodeMs,
+            mbps,
+            avgKb,
+            static_cast<unsigned long long>(keys),
+            static_cast<unsigned long long>(eglHits),
+            static_cast<unsigned long long>(eglTotal),
+            p95(fenceWaitMs),
+            p95(cudaMapMs),
+            p95(cudaUnmapMs));
+}
+
+int H264NvencEncoder::receivePacket()
+{
+    if (!m_packet) {
+        return SoftwareEncoder::receivePacket();
+    }
+
+    const bool trackStats = PIPEWIRERECORDFRAMESTATS_LOGGING().isDebugEnabled();
+    int received = 0;
+
+    for (;;) {
+        const auto t0 = trackStats ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
+        int ret = -1;
+        {
+            std::lock_guard<std::mutex> guard(m_avCodecMutex);
+            ret = avcodec_receive_packet(m_avCodecContext, m_packet);
+        }
+        if (ret < 0) {
+            if (ret != AVERROR_EOF && ret != AVERROR(EAGAIN)) {
+                qCWarning(PIPEWIRERECORD_LOGGING) << "Error encoding a frame:" << av_err2str(ret);
+            }
+            av_packet_unref(m_packet);
+            break;
+        }
+
+        if (trackStats) {
+            const auto dtUs = std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count();
+            m_stats->recvUs += static_cast<uint64_t>(std::max<int64_t>(dtUs, 0));
+            m_stats->pktCount++;
+            m_stats->pktBytes += static_cast<uint64_t>(std::max(m_packet->size, 0));
+            if (m_packet->flags & AV_PKT_FLAG_KEY) {
+                m_stats->keyCount++;
+            }
+        }
+
+        received++;
+
+        m_produce->processPacket(m_packet);
+        av_packet_unref(m_packet);
+    }
+
+    if (trackStats && received > 0) {
+        maybeLogTelemetry();
+    }
+
+    return received;
+}
+
+void H264NvencEncoder::setQuality(std::optional<quint8> quality)
+{
+    SoftwareEncoder::setQuality(quality);
+    if (!m_codecOpen || !m_avCodecContext) {
+        return;
+    }
+
+    // FFmpeg's h264_nvenc does not re-read cq mid-stream, but updating non-zero
+    // bit_rate / rc_max_rate / rc_buffer_size triggers nvEncReconfigureEncoder()
+    // live on the next frame (both down when throttling and back up on recovery).
+    const double q = std::clamp<double>(quality.value_or(75), 0.0, 100.0);
+    double fps = 60.0;
+    if (m_avCodecContext->framerate.num > 0 && m_avCodecContext->framerate.den > 0) {
+        fps = static_cast<double>(m_avCodecContext->framerate.num) / static_cast<double>(m_avCodecContext->framerate.den);
+    }
+    fps = std::clamp(fps, 15.0, 240.0);
+
+    const double pps = static_cast<double>(m_avCodecContext->width) * static_cast<double>(m_avCodecContext->height) * fps;
+    // Exponential bits-per-pixel curve: ~1.9..31 Mbps at 1080p60, ~7.5..124 Mbps at 4K60.
+    const double bpp = 0.015 * std::pow(0.25 / 0.015, q / 100.0);
+    int64_t targetBitrate = std::clamp<int64_t>(static_cast<int64_t>(pps * bpp), 500000, 150000000);
+    int64_t maxBitrate = std::clamp<int64_t>(static_cast<int64_t>(targetBitrate * 1.25), 750000, 180000000);
+
+    if (m_configuredMaxRate > 0) {
+        maxBitrate = std::min(maxBitrate, m_configuredMaxRate);
+        targetBitrate = std::min(targetBitrate, maxBitrate);
+    }
+
+    std::lock_guard<std::mutex> guard(m_avCodecMutex);
+    m_avCodecContext->bit_rate = targetBitrate;
+    m_avCodecContext->rc_max_rate = maxBitrate;
+    m_avCodecContext->rc_buffer_size = static_cast<int>(std::clamp<int64_t>(maxBitrate / 2, 250000, 100000000));
+}
+
+AVDictionary *H264NvencEncoder::buildEncodingOptions()
+{
+    AVDictionary *options = nullptr;
+
+    // h264_nvenc uses its own private profile option (which defaults to "high"
+    // and overrides AVCodecContext::profile), so set it explicitly.
+    switch (m_profile) {
+    case H264Profile::Baseline:
+        av_dict_set(&options, "profile", "baseline", 0);
+        break;
+    case H264Profile::Main:
+        av_dict_set(&options, "profile", "main", 0);
+        break;
+    case H264Profile::High:
+        av_dict_set(&options, "profile", "high", 0);
+        break;
+    }
+
+    // libx264-style presets are rejected by h264_nvenc, so use NVENC's own.
+    // Speed / NoPreference target interactive streaming (KRdp) with zero frame
+    // buffering; Quality / Size keep NVENC's HQ lookahead pipeline intact.
+    QByteArray preset;
+    QByteArray tune;
+    switch (m_encodingPreference) {
+    case PipeWireBaseEncodedStream::EncodingPreference::Speed:
+        preset = "p1";
+        tune = "ull";
+        break;
+    case PipeWireBaseEncodedStream::EncodingPreference::Quality:
+        preset = "p6";
+        tune = "hq";
+        break;
+    case PipeWireBaseEncodedStream::EncodingPreference::Size:
+        preset = "p7";
+        tune = "hq";
+        break;
+    case PipeWireBaseEncodedStream::EncodingPreference::NoPreference:
+    default:
+        preset = "p4";
+        tune = "ll";
+        break;
+    }
+
+    if (const QByteArray envPreset = qgetenv("KPIPEWIRE_NVENC_PRESET").trimmed(); !envPreset.isEmpty()) {
+        if (envPreset == "p1" || envPreset == "p2" || envPreset == "p3" || envPreset == "p4" || envPreset == "p5" || envPreset == "p6" || envPreset == "p7"
+            || envPreset == "fast" || envPreset == "medium" || envPreset == "slow") {
+            preset = envPreset;
+        } else {
+            qCWarning(PIPEWIRERECORD_LOGGING) << "Ignoring unsupported KPIPEWIRE_NVENC_PRESET:" << envPreset;
+        }
+    }
+
+    if (const QByteArray envTune = qgetenv("KPIPEWIRE_NVENC_TUNE").trimmed(); !envTune.isEmpty()) {
+        if (envTune == "ull" || envTune == "ll" || envTune == "hq" || envTune == "lossless") {
+            tune = envTune;
+        } else {
+            qCWarning(PIPEWIRERECORD_LOGGING) << "Ignoring unsupported KPIPEWIRE_NVENC_TUNE:" << envTune;
+        }
+    }
+
+    av_dict_set(&options, "preset", preset.constData(), 0);
+    av_dict_set(&options, "tune", tune.constData(), 0);
+
+    // Low-latency modes disable multipass and frame buffering; HQ keeps lookahead
+    // (NVENC rejects delay=0 with p6/p7 + tune=hq).
+    if (tune == "ll" || tune == "ull") {
+        av_dict_set(&options, "multipass", "disabled", 0);
+        av_dict_set(&options, "zerolatency", "1", 0);
+        av_dict_set_int(&options, "delay", 0, 0);
+        av_dict_set_int(&options, "surfaces", 8, 0);
+    }
+
+    // Spatial AQ sharpens desktop UI/text at negligible GPU cost; opt out with =0.
+    bool spatialAq = true;
+    if (qEnvironmentVariableIsSet("KPIPEWIRE_NVENC_SPATIAL_AQ")) {
+        spatialAq = (qEnvironmentVariableIntValue("KPIPEWIRE_NVENC_SPATIAL_AQ") != 0);
+    }
+    av_dict_set(&options, "spatial-aq", spatialAq ? "1" : "0", 0);
+
+    if (qEnvironmentVariableIntValue("KPIPEWIRE_NVENC_INTRA_REFRESH") != 0) {
+        av_dict_set(&options, "intra-refresh", "1", 0);
+    }
+
+    // Skip unused closed-caption/timecode/extra SEI side-data processing per frame.
+    av_dict_set(&options, "a53cc", "0", 0);
+    av_dict_set(&options, "s12m_tc", "0", 0);
+    av_dict_set(&options, "extra_sei", "0", 0);
+
+    // Constant-quality VBR at open (optional VBV ceiling via KPIPEWIRE_NVENC_MAXRATE;
+    // subsequent runtime setQuality() calls dynamically reconfigure VBR/VBV).
+    int cq = m_quality ? std::clamp(int(51 - (m_quality.value() / 100.0) * 51), 1, 51) : 25;
+    if (qEnvironmentVariableIsSet("KPIPEWIRE_NVENC_CQ")) {
+        bool ok = false;
+        const int envCq = qEnvironmentVariableIntValue("KPIPEWIRE_NVENC_CQ", &ok);
+        if (ok && envCq >= 1 && envCq <= 51) {
+            cq = envCq;
+        }
+    }
+    av_dict_set(&options, "rc", "vbr", 0);
+    av_dict_set_int(&options, "cq", cq, 0);
+    av_dict_set_int(&options, "b", 0, 0);
+
+    return options;
+}
