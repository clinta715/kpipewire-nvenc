+// Parse bitrate strings such as "25M", "15000k", or "20000000" (bits/sec).
+int64_t parseBitrateEnv(const char *varName)
+{
+    const QByteArray raw = qgetenv(varName).trimmed();
+    if (raw.isEmpty()) {
+        return 0;
+    }
+
+    int64_t multiplier = 1;
+    QByteArray numPart = raw;
+    const char last = raw.back();
+    if (last == 'k' || last == 'K') {
+        multiplier = 1000;
+        numPart.chop(1);
+    } else if (last == 'm' || last == 'M') {
+        multiplier = 1000000;
+        numPart.chop(1);
+    }
+
+    bool ok = false;
+    const double val = numPart.toDouble(&ok);
+    if (!ok || !(val > 0.0)) {
+        qCWarning(PIPEWIRERECORD_LOGGING) << "Ignoring invalid" << varName << "value:" << raw;
+        return 0;
+    }
+
+    const double bits = val * static_cast<double>(multiplier);
+    return std::clamp<int64_t>(static_cast<int64_t>(bits), 500000, 200000000);
+}
