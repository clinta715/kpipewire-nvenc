+constexpr const char *kVertexShaderSrc = R"GLSL(
+#version 330 core
+void main()
+{
+    vec2 pos = vec2((gl_VertexID == 1) ? 3.0 : -1.0,
+                    (gl_VertexID == 2) ? 3.0 : -1.0);
