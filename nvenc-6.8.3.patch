+struct H264NvencEncoder::FastDmaBufDownloader {
+    int drmFd = -1;
+    gbm_device *gbmDevice = nullptr;
+    EGLDisplay eglDisplay = EGL_NO_DISPLAY;
+    EGLContext eglContext = EGL_NO_CONTEXT;
+    bool hasDmaBufModifiers = false;
+    GLuint tex = 0;
+    GLuint fbo = 0;
+    std::vector<CachedEglImage> imageCache;
+    bool triedInit = false;
+    bool initialized = false;
+
+    ~FastDmaBufDownloader()
+    {
+        cleanup();
+    }
+
+    void cleanup()
+    {
+        const bool haveContext = (eglDisplay != EGL_NO_DISPLAY && eglContext != EGL_NO_CONTEXT);
+        if (haveContext && eglMakeCurrent(eglDisplay, EGL_NO_SURFACE, EGL_NO_SURFACE, eglContext)) {
+            if (fbo) {
+                glDeleteFramebuffers(1, &fbo);
+                fbo = 0;
+            }
+            if (tex) {
+                glDeleteTextures(1, &tex);
+                tex = 0;
+            }
+            eglMakeCurrent(eglDisplay, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+        }
+        if (eglDisplay != EGL_NO_DISPLAY) {
+            for (const auto &entry : imageCache) {
+                if (entry.image != EGL_NO_IMAGE_KHR) {
+                    eglDestroyImageKHR(eglDisplay, entry.image);
+                }
+            }
+            imageCache.clear();
+            if (eglContext != EGL_NO_CONTEXT) {
+                eglDestroyContext(eglDisplay, eglContext);
+                eglContext = EGL_NO_CONTEXT;
+            }
+            eglTerminate(eglDisplay);
+            eglDisplay = EGL_NO_DISPLAY;
+        }
+        if (gbmDevice) {
+            gbm_device_destroy(gbmDevice);
+            gbmDevice = nullptr;
+        }
+        if (drmFd >= 0) {
+            close(drmFd);
+            drmFd = -1;
+        }
+        initialized = false;
+    }
+
+    // Initialize a non-debug GBM/EGL context with persistent texture/FBO and
+    // LRU EGLImage cache. When skipRenderNode is set (hybrid multi-GPU fallback),
+    // skip that node so we open the compositor's GPU (e.g. Intel/AMD iGPU).
+    bool init(const QByteArray &skipRenderNode)
+    {
+        if (triedInit) {
+            return initialized;
+        }
+        triedInit = true;
+
+        QList<QByteArray> nodes = findCandidateRenderNodes();
+        if (!skipRenderNode.isEmpty()) {
+            nodes.removeAll(skipRenderNode);
+        }
+
+        for (const QByteArray &nodePath : nodes) {
+            int fd = open(nodePath.constData(), O_RDWR | O_CLOEXEC);
+            if (fd < 0) {
+                continue;
+            }
+            gbm_device *gbm = gbm_create_device(fd);
+            if (!gbm) {
+                close(fd);
+                continue;
+            }
+
+            EGLDisplay dpy = eglGetPlatformDisplayEXT(EGL_PLATFORM_GBM_MESA, gbm, nullptr);
+            EGLint major = 0;
+            EGLint minor = 0;
+            if (dpy == EGL_NO_DISPLAY || !eglInitialize(dpy, &major, &minor)) {
+                if (dpy != EGL_NO_DISPLAY) {
+                    eglTerminate(dpy);
+                }
+                gbm_device_destroy(gbm);
+                close(fd);
+                continue;
+            }
+
+            if (!epoxy_has_egl_extension(dpy, "EGL_EXT_image_dma_buf_import") || !eglBindAPI(EGL_OPENGL_API)) {
+                eglTerminate(dpy);
+                gbm_device_destroy(gbm);
+                close(fd);
+                continue;
+            }
+
+            static constexpr EGLint cfgAttribs[] = {
+                EGL_RENDERABLE_TYPE, EGL_OPENGL_BIT,
+                EGL_NONE,
+            };
+            EGLConfig cfg = nullptr;
+            EGLint cfgCount = 0;
+            if (!eglChooseConfig(dpy, cfgAttribs, &cfg, 1, &cfgCount) || cfgCount < 1) {
+                eglTerminate(dpy);
+                gbm_device_destroy(gbm);
+                close(fd);
+                continue;
+            }
+
+            // No EGL_CONTEXT_OPENGL_DEBUG (unlike DmaBufHandler) to avoid driver validation overhead.
+            EGLContext ctx = eglCreateContext(dpy, cfg, EGL_NO_CONTEXT, nullptr);
+            if (ctx == EGL_NO_CONTEXT || !eglMakeCurrent(dpy, EGL_NO_SURFACE, EGL_NO_SURFACE, ctx)) {
+                if (ctx != EGL_NO_CONTEXT) {
+                    eglDestroyContext(dpy, ctx);
+                }
+                eglTerminate(dpy);
+                gbm_device_destroy(gbm);
+                close(fd);
+                continue;
+            }
+
+            GLuint t = 0;
+            GLuint f = 0;
+            glGenTextures(1, &t);
+            glBindTexture(GL_TEXTURE_2D, t);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+            glGenFramebuffers(1, &f);
+
+            drmFd = fd;
+            gbmDevice = gbm;
+            eglDisplay = dpy;
+            eglContext = ctx;
+            hasDmaBufModifiers = epoxy_has_egl_extension(dpy, "EGL_EXT_image_dma_buf_import_modifiers");
+            tex = t;
+            fbo = f;
+            initialized = true;
+            qCInfo(PIPEWIRERECORD_LOGGING) << "NVENC fast DMA-BUF downloader initialized on" << nodePath;
+            return true;
+        }
+        return false;
+    }
+
+    bool download(uint8_t *dst, GLenum readFormat, const PipeWireFrame &frame, const QByteArray &skipRenderNode)
+    {
+        if (!frame.dmabuf || frame.dmabuf->planes.isEmpty()) {
+            return false;
+        }
+        if (!init(skipRenderNode)) {
+            return false;
+        }
+        if (eglGetCurrentContext() != eglContext) {
+            if (!eglMakeCurrent(eglDisplay, EGL_NO_SURFACE, EGL_NO_SURFACE, eglContext)) {
+                return false;
+            }
+        }
+
+        const auto &dmabuf = *frame.dmabuf;
+        const uint32_t drmFormat = dmabuf.format ? dmabuf.format : PipeWireSourceStream::spaVideoFormatToDrmFormat(frame.format);
+        bool cached = false;
+        bool cacheHit = false;
+        EGLImageKHR img = importDmaBufEglImage(eglDisplay, hasDmaBufModifiers, imageCache, dmabuf, drmFormat, cached, cacheHit);
+        if (img == EGL_NO_IMAGE_KHR) {
+            return false;
+        }
+
+        // Clear earlier errors so the result describes this download.
+        while (glGetError() != GL_NO_ERROR) {
+        }
+        glBindTexture(GL_TEXTURE_2D, tex);
+        glEGLImageTargetTexture2DOES(GL_TEXTURE_2D, img);
+        glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, tex, 0);
+
+        const bool complete = (glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE);
+        if (complete) {
+            glPixelStorei(GL_PACK_ALIGNMENT, 4);
+            glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+            glReadPixels(0, 0, dmabuf.width, dmabuf.height, readFormat, GL_UNSIGNED_BYTE, dst);
+        }
+
+        glBindFramebuffer(GL_FRAMEBUFFER, 0);
+        if (!cached) {
+            eglDestroyImageKHR(eglDisplay, img);
+        }
+        return glGetError() == GL_NO_ERROR && complete;
+    }
+};
