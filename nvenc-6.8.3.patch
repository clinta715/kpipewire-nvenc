+struct DmaBufImageKey {
+    struct PlaneKey {
+        int fd = -1;
+        dev_t dev = 0;
+        ino_t ino = 0;
+        uint32_t offset = 0;
+        uint32_t stride = 0;
+        bool operator==(const PlaneKey &) const = default;
+    };
+
+    int width = 0;
+    int height = 0;
+    uint32_t drmFormat = 0;
+    uint64_t modifier = 0;
+    int planeCount = 0;
+    PlaneKey planes[4];
+
+    bool operator==(const DmaBufImageKey &) const = default;
+};
+
+struct CachedEglImage {
+    DmaBufImageKey key;
+    EGLImageKHR image = EGL_NO_IMAGE_KHR;
+};
+
+constexpr size_t kMaxCachedEglImages = 16;
+
+// Import a PipeWire DMA-BUF into an EGLImageKHR using a bounded LRU cache keyed
+// by kernel DMA-BUF identity (st_dev, st_ino) plus layout, evicting stale fd reuse.
+EGLImageKHR importDmaBufEglImage(EGLDisplay display,
+                                 bool hasDmaBufModifiers,
+                                 std::vector<CachedEglImage> &cache,
+                                 const DmaBufAttributes &dmabuf,
+                                 uint32_t drmFormat,
+                                 bool &isCached,
+                                 bool &cacheHit)
+{
+    isCached = false;
+    cacheHit = false;
+
+    const bool useModifier = hasDmaBufModifiers && dmabuf.modifier != DRM_FORMAT_MOD_INVALID;
+    const int planeCount = std::min<int>(dmabuf.planes.count(), 4);
+
+    DmaBufImageKey key;
+    key.width = dmabuf.width;
+    key.height = dmabuf.height;
+    key.drmFormat = drmFormat;
+    key.modifier = useModifier ? dmabuf.modifier : DRM_FORMAT_MOD_INVALID;
+    key.planeCount = planeCount;
+
+    bool canCache = true;
+    for (int i = 0; i < planeCount; ++i) {
+        const auto &plane = dmabuf.planes[i];
+        struct stat st{};
+        if (fstat(plane.fd, &st) != 0) {
+            canCache = false;
+            break;
+        }
+        key.planes[i] = {plane.fd, st.st_dev, st.st_ino, plane.offset, plane.stride};
+    }
+
+    if (canCache) {
+        for (auto it = cache.begin(); it != cache.end();) {
+            if (it->key == key) {
+                EGLImageKHR img = it->image;
+                if (it != cache.begin()) {
+                    std::rotate(cache.begin(), it, it + 1);
+                }
+                isCached = true;
+                cacheHit = true;
+                return img;
+            }
+            bool staleFd = false;
+            for (int i = 0; i < planeCount && !staleFd; ++i) {
+                for (int j = 0; j < it->key.planeCount; ++j) {
+                    if (it->key.planes[j].fd == key.planes[i].fd
+                        && (it->key.planes[j].dev != key.planes[i].dev || it->key.planes[j].ino != key.planes[i].ino)) {
+                        staleFd = true;
+                        break;
+                    }
+                }
+            }
+            if (staleFd) {
+                eglDestroyImageKHR(display, it->image);
+                it = cache.erase(it);
+            } else {
+                ++it;
+            }
+        }
+    }
+
+    QVarLengthArray<EGLint, 48> attribs;
+    attribs.append(EGL_WIDTH);
+    attribs.append(dmabuf.width);
+    attribs.append(EGL_HEIGHT);
+    attribs.append(dmabuf.height);
+    attribs.append(EGL_LINUX_DRM_FOURCC_EXT);
+    attribs.append(static_cast<EGLint>(drmFormat));
+
+    static constexpr EGLint kFdKeys[4] = {
+        EGL_DMA_BUF_PLANE0_FD_EXT,
+        EGL_DMA_BUF_PLANE1_FD_EXT,
+        EGL_DMA_BUF_PLANE2_FD_EXT,
+        EGL_DMA_BUF_PLANE3_FD_EXT,
+    };
+    static constexpr EGLint kOffsetKeys[4] = {
+        EGL_DMA_BUF_PLANE0_OFFSET_EXT,
+        EGL_DMA_BUF_PLANE1_OFFSET_EXT,
+        EGL_DMA_BUF_PLANE2_OFFSET_EXT,
+        EGL_DMA_BUF_PLANE3_OFFSET_EXT,
+    };
+    static constexpr EGLint kPitchKeys[4] = {
+        EGL_DMA_BUF_PLANE0_PITCH_EXT,
+        EGL_DMA_BUF_PLANE1_PITCH_EXT,
+        EGL_DMA_BUF_PLANE2_PITCH_EXT,
+        EGL_DMA_BUF_PLANE3_PITCH_EXT,
+    };
+    static constexpr EGLint kModLoKeys[4] = {
+        EGL_DMA_BUF_PLANE0_MODIFIER_LO_EXT,
+        EGL_DMA_BUF_PLANE1_MODIFIER_LO_EXT,
+        EGL_DMA_BUF_PLANE2_MODIFIER_LO_EXT,
+        EGL_DMA_BUF_PLANE3_MODIFIER_LO_EXT,
+    };
+    static constexpr EGLint kModHiKeys[4] = {
+        EGL_DMA_BUF_PLANE0_MODIFIER_HI_EXT,
+        EGL_DMA_BUF_PLANE1_MODIFIER_HI_EXT,
+        EGL_DMA_BUF_PLANE2_MODIFIER_HI_EXT,
+        EGL_DMA_BUF_PLANE3_MODIFIER_HI_EXT,
+    };
+
+    for (int i = 0; i < planeCount; ++i) {
+        const auto &plane = dmabuf.planes[i];
+        attribs.append(kFdKeys[i]);
+        attribs.append(plane.fd);
+        attribs.append(kOffsetKeys[i]);
+        attribs.append(static_cast<EGLint>(plane.offset));
+        attribs.append(kPitchKeys[i]);
+        attribs.append(static_cast<EGLint>(plane.stride));
+        if (useModifier) {
+            attribs.append(kModLoKeys[i]);
+            attribs.append(static_cast<EGLint>(dmabuf.modifier & 0xffffffffu));
+            attribs.append(kModHiKeys[i]);
+            attribs.append(static_cast<EGLint>(dmabuf.modifier >> 32));
+        }
+    }
+    attribs.append(EGL_NONE);
+
+    EGLImageKHR img = eglCreateImageKHR(display, EGL_NO_CONTEXT, EGL_LINUX_DMA_BUF_EXT, nullptr, attribs.constData());
+    if (img != EGL_NO_IMAGE_KHR && canCache) {
+        if (cache.size() >= kMaxCachedEglImages) {
+            eglDestroyImageKHR(display, cache.back().image);
+            cache.pop_back();
+        }
+        cache.insert(cache.begin(), CachedEglImage{key, img});
+        isCached = true;
+    }
+    return img;
+}
