+// Minimal CUDA driver API declarations loaded dynamically from libcuda.so.1
+// so building KPipeWire requires no CUDA toolkit headers.
+using CUresult = int;
+using CUcontext = struct CUctx_st *;
+using CUstream = struct CUstream_st *;
+using CUarray = struct CUarray_st *;
+using CUgraphicsResource = struct CUgraphicsResource_st *;
+using CUdeviceptr = uint64_t;
+
+constexpr CUresult kCudaSuccess = 0;
+constexpr unsigned int kCuGraphicsRegisterFlagsReadOnly = 1;
+constexpr int kCuMemoryTypeDevice = 2;
+constexpr int kCuMemoryTypeArray = 3;
+constexpr int kCuGlDeviceListAll = 1;
+constexpr int kAvCudaUsePrimaryContext = (1 << 0);
+
+struct CudaMemcpy2D {
+    size_t srcXInBytes = 0;
+    size_t srcY = 0;
+    int srcMemoryType = 0;
+    const void *srcHost = nullptr;
+    CUdeviceptr srcDevice = 0;
+    CUarray srcArray = nullptr;
+    size_t srcPitch = 0;
+
+    size_t dstXInBytes = 0;
+    size_t dstY = 0;
+    int dstMemoryType = 0;
+    void *dstHost = nullptr;
+    CUdeviceptr dstDevice = 0;
+    CUarray dstArray = nullptr;
+    size_t dstPitch = 0;
+
+    size_t WidthInBytes = 0;
+    size_t Height = 0;
+};
+
+// Mirrors FFmpeg's AVCUDADeviceContext from <libavutil/hwcontext_cuda.h>.
+struct AvCudaDeviceContext {
+    CUcontext cuda_ctx;
+    CUstream stream;
+    void *internal;
+};
+
+struct CudaApi {
+    using cuCtxPushCurrent_t = CUresult (*)(CUcontext);
+    using cuCtxPopCurrent_t = CUresult (*)(CUcontext *);
+    using cuGLGetDevices_t = CUresult (*)(unsigned int *, int *, unsigned int, int);
+    using cuGraphicsGLRegisterImage_t = CUresult (*)(CUgraphicsResource *, GLuint, GLenum, unsigned int);
+    using cuGraphicsMapResources_t = CUresult (*)(unsigned int, CUgraphicsResource *, CUstream);
+    using cuGraphicsUnmapResources_t = CUresult (*)(unsigned int, CUgraphicsResource *, CUstream);
+    using cuGraphicsSubResourceGetMappedArray_t = CUresult (*)(CUarray *, CUgraphicsResource, unsigned int, unsigned int);
+    using cuGraphicsUnregisterResource_t = CUresult (*)(CUgraphicsResource);
+    using cuMemcpy2DAsync_t = CUresult (*)(const CudaMemcpy2D *, CUstream);
+
+    cuCtxPushCurrent_t ctxPushCurrent = nullptr;
+    cuCtxPopCurrent_t ctxPopCurrent = nullptr;
+    cuGLGetDevices_t glGetDevices = nullptr;
+    cuGraphicsGLRegisterImage_t graphicsGLRegisterImage = nullptr;
+    cuGraphicsMapResources_t graphicsMapResources = nullptr;
+    cuGraphicsUnmapResources_t graphicsUnmapResources = nullptr;
+    cuGraphicsSubResourceGetMappedArray_t graphicsSubResourceGetMappedArray = nullptr;
+    cuGraphicsUnregisterResource_t graphicsUnregisterResource = nullptr;
+    cuMemcpy2DAsync_t memcpy2DAsync = nullptr;
+    bool loaded = false;
+
+    static const CudaApi &instance()
+    {
+        static CudaApi api = []() {
+            CudaApi out;
+            void *lib = dlopen("libcuda.so.1", RTLD_LAZY | RTLD_LOCAL);
+            if (!lib) {
+                return out;
+            }
+            out.ctxPushCurrent = reinterpret_cast<cuCtxPushCurrent_t>(dlsym(lib, "cuCtxPushCurrent_v2"));
+            out.ctxPopCurrent = reinterpret_cast<cuCtxPopCurrent_t>(dlsym(lib, "cuCtxPopCurrent_v2"));
+            out.glGetDevices = reinterpret_cast<cuGLGetDevices_t>(dlsym(lib, "cuGLGetDevices_v2"));
+            out.graphicsGLRegisterImage = reinterpret_cast<cuGraphicsGLRegisterImage_t>(dlsym(lib, "cuGraphicsGLRegisterImage"));
+            out.graphicsMapResources = reinterpret_cast<cuGraphicsMapResources_t>(dlsym(lib, "cuGraphicsMapResources"));
+            out.graphicsUnmapResources = reinterpret_cast<cuGraphicsUnmapResources_t>(dlsym(lib, "cuGraphicsUnmapResources"));
+            out.graphicsSubResourceGetMappedArray =
+                reinterpret_cast<cuGraphicsSubResourceGetMappedArray_t>(dlsym(lib, "cuGraphicsSubResourceGetMappedArray"));
+            out.graphicsUnregisterResource = reinterpret_cast<cuGraphicsUnregisterResource_t>(dlsym(lib, "cuGraphicsUnregisterResource"));
+            out.memcpy2DAsync = reinterpret_cast<cuMemcpy2DAsync_t>(dlsym(lib, "cuMemcpy2DAsync_v2"));
+            out.loaded = out.ctxPushCurrent && out.ctxPopCurrent && out.glGetDevices && out.graphicsGLRegisterImage
+                && out.graphicsMapResources && out.graphicsUnmapResources && out.graphicsSubResourceGetMappedArray
+                && out.graphicsUnregisterResource && out.memcpy2DAsync;
+            return out;
+        }();
+        return api;
+    }
+};
