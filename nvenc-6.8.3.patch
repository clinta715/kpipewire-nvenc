+/**
+ * Hardware H.264 encoder using NVIDIA NVENC (h264_nvenc).
+ *
+ * When a CUDA-capable NVIDIA EGL/GBM render node is available, DMA-BUF frames
+ * are imported directly on the GPU via EGLImage, converted to BT.709 NV12
+ * (full or limited range, with black padding for odd dimensions) in OpenGL,
+ * copied VRAM-to-VRAM into a pooled AV_PIX_FMT_CUDA surface via CUDA-GL
+ * interop, and handed straight to h264_nvenc with zero PCIe round-trip.
+ *
+ * If GPU interop cannot be initialized (or KPIPEWIRE_NVENC_NO_ZEROCOPY=1 is
+ * set), it falls back to a pooled single-pass NV12 software upload path.
+ */
+class H264NvencEncoder : public SoftwareEncoder
+{
+public:
+    H264NvencEncoder(H264Profile profile, PipeWireProduce *produce);
+    ~H264NvencEncoder() override;
+
+    bool initialize(const QSize &size) override;
+    bool filterFrame(const PipeWireFrame &frame) override;
+    std::pair<int, int> encodeFrame(int maximumFrames) override;
+    int receivePacket() override;
+    void setQuality(std::optional<quint8> quality) override;
+
