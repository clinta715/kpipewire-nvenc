+H264NvencEncoder::~H264NvencEncoder()
+{
+    // Close the codec context before tearing down CUDA/EGL so NVENC releases
+    // its references to our hardware frames context first.
+    if (m_avCodecContext) {
+        avcodec_free_context(&m_avCodecContext);
+    }
+
+    cleanupGpuPath();
+
+    if (m_swBufferPool) {
+        av_buffer_pool_uninit(&m_swBufferPool);
+    }
+}
+
+void H264NvencEncoder::cleanupGpuPath()
+{
+    if (!m_gpu) {
+        return;
+    }
+
+    {
+        std::lock_guard<std::mutex> lock(m_gpu->queueMutex);
+        while (!m_gpu->frameQueue.empty()) {
+            AVFrame *frame = m_gpu->frameQueue.front();
+            m_gpu->frameQueue.pop_front();
+            av_frame_free(&frame);
+        }
+    }
+
+    const auto &cuda = CudaApi::instance();
+    const bool haveContext = (m_gpu->eglDisplay != EGL_NO_DISPLAY && m_gpu->eglContext != EGL_NO_CONTEXT);
+    const bool madeCurrent = haveContext && eglMakeCurrent(m_gpu->eglDisplay, EGL_NO_SURFACE, EGL_NO_SURFACE, m_gpu->eglContext);
+
+    if (m_gpu->cudaDeviceCtx && cuda.loaded && (m_gpu->yCudaRes || m_gpu->uvCudaRes)) {
+        auto *devCtx = reinterpret_cast<AVHWDeviceContext *>(m_gpu->cudaDeviceCtx->data);
+        auto *cuCtx = reinterpret_cast<AvCudaDeviceContext *>(devCtx->hwctx);
+        if (cuda.ctxPushCurrent(cuCtx->cuda_ctx) == kCudaSuccess) {
+            if (m_gpu->yCudaRes) {
+                cuda.graphicsUnregisterResource(m_gpu->yCudaRes);
+                m_gpu->yCudaRes = nullptr;
+            }
+            if (m_gpu->uvCudaRes) {
+                cuda.graphicsUnregisterResource(m_gpu->uvCudaRes);
+                m_gpu->uvCudaRes = nullptr;
+            }
+            CUcontext popped = nullptr;
+            cuda.ctxPopCurrent(&popped);
+        }
+    }
+
+    if (madeCurrent) {
+        if (m_gpu->fboY) {
+            glDeleteFramebuffers(1, &m_gpu->fboY);
+        }
+        if (m_gpu->fboUV) {
+            glDeleteFramebuffers(1, &m_gpu->fboUV);
+        }
+        if (m_gpu->srcTex) {
+            glDeleteTextures(1, &m_gpu->srcTex);
+        }
+        if (m_gpu->shmTex) {
+            glDeleteTextures(1, &m_gpu->shmTex);
+        }
+        if (m_gpu->yTex) {
+            glDeleteTextures(1, &m_gpu->yTex);
+        }
+        if (m_gpu->uvTex) {
+            glDeleteTextures(1, &m_gpu->uvTex);
+        }
+        if (m_gpu->progY) {
+            glDeleteProgram(m_gpu->progY);
+        }
+        if (m_gpu->progUV) {
+            glDeleteProgram(m_gpu->progUV);
+        }
+        if (m_gpu->vao) {
+            glDeleteVertexArrays(1, &m_gpu->vao);
+        }
+        eglMakeCurrent(m_gpu->eglDisplay, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+    }
+
+    if (m_gpu->eglDisplay != EGL_NO_DISPLAY) {
+        if (m_gpu->eglContext != EGL_NO_CONTEXT) {
+            eglDestroyContext(m_gpu->eglDisplay, m_gpu->eglContext);
+        }
+        eglTerminate(m_gpu->eglDisplay);
+    }
+
+    if (m_gpu->cudaFramesCtx) {
+        av_buffer_unref(&m_gpu->cudaFramesCtx);
+    }
+    if (m_gpu->cudaDeviceCtx) {
+        av_buffer_unref(&m_gpu->cudaDeviceCtx);
+    }
+    if (m_gpu->gbmDevice) {
+        gbm_device_destroy(m_gpu->gbmDevice);
+    }
+    if (m_gpu->drmFd >= 0) {
+        close(m_gpu->drmFd);
+    }
+
+    m_gpu.reset();
+}
