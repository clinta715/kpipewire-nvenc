+// ITU-R BT.709 RGB -> Y (full or limited range) with black padding for odd dimensions.
+constexpr const char *kFragYSrc = R"GLSL(
+#version 330 core
+uniform sampler2D uSrc;
+uniform ivec2 uSrcSize;
+uniform int uFullRange;
+out float outY;
+void main()
+{
+    ivec2 p = ivec2(gl_FragCoord.xy);
+    if (p.x >= uSrcSize.x || p.y >= uSrcSize.y) {
+        outY = (uFullRange != 0) ? 0.0 : (16.0 / 255.0);
+        return;
+    }
+    vec3 rgb = texelFetch(uSrc, p, 0).rgb;
+    float y = dot(rgb, vec3(0.2126, 0.7152, 0.0722));
+    outY = (uFullRange != 0) ? y : (16.0 / 255.0 + (219.0 / 255.0) * y);
+}
+)GLSL";
+
+// ITU-R BT.709 RGB -> interleaved UV (NV12 chroma plane, 2x2 box filter).
+constexpr const char *kFragUVSrc = R"GLSL(
+#version 330 core
+uniform sampler2D uSrc;
+uniform ivec2 uSrcSize;
+uniform int uFullRange;
+out vec2 outUV;
+vec3 samplePadded(ivec2 p)
+{
+    if (p.x >= uSrcSize.x || p.y >= uSrcSize.y) {
+        return vec3(0.0);
+    }
+    return texelFetch(uSrc, p, 0).rgb;
+}
+void main()
+{
+    ivec2 b = ivec2(gl_FragCoord.xy) * 2;
+    vec3 rgb = 0.25 * (samplePadded(b)
+                     + samplePadded(b + ivec2(1, 0))
+                     + samplePadded(b + ivec2(0, 1))
+                     + samplePadded(b + ivec2(1, 1)));
+    float u = dot(rgb, vec3(-0.114572, -0.385428, 0.5));
+    float v = dot(rgb, vec3(0.5, -0.454153, -0.045847));
+    if (uFullRange != 0) {
+        outUV = vec2(u + 0.5, v + 0.5);
+    } else {
+        outUV = vec2(128.0 / 255.0 + (224.0 / 255.0) * u,
+                     128.0 / 255.0 + (224.0 / 255.0) * v);
+    }
+}
+)GLSL";
+
+// Single-pass GL 4.3 compute shader: reads each 2x2 RGB block once and writes
+// both BT.709 NV12 planes (Y in r8, interleaved UV in rg8) with black padding.
+constexpr const char *kComputeNv12Src = R"GLSL(
+#version 430 core
+layout(local_size_x = 16, local_size_y = 16) in;
+uniform sampler2D uSrc;
+uniform ivec2 uSrcSize;
+uniform ivec2 uCodedSize;
+uniform int uFullRange;
+layout(r8, binding = 0) writeonly uniform image2D uOutY;
+layout(rg8, binding = 1) writeonly uniform image2D uOutUV;
+
+vec3 fetchPadded(ivec2 p)
+{
+    if (p.x >= uSrcSize.x || p.y >= uSrcSize.y) {
+        return vec3(0.0);
+    }
+    return texelFetch(uSrc, p, 0).rgb;
+}
+
+float rgbToY(vec3 rgb)
+{
+    float y = dot(rgb, vec3(0.2126, 0.7152, 0.0722));
+    return (uFullRange != 0) ? y : (16.0 / 255.0 + (219.0 / 255.0) * y);
+}
+
+void main()
+{
+    ivec2 uvPos = ivec2(gl_GlobalInvocationID.xy);
+    if (uvPos.x >= uCodedSize.x / 2 || uvPos.y >= uCodedSize.y / 2) {
+        return;
+    }
+    ivec2 b = uvPos * 2;
+    vec3 c00 = fetchPadded(b);
+    vec3 c10 = fetchPadded(b + ivec2(1, 0));
+    vec3 c01 = fetchPadded(b + ivec2(0, 1));
+    vec3 c11 = fetchPadded(b + ivec2(1, 1));
+
+    imageStore(uOutY, b, vec4(rgbToY(c00), 0.0, 0.0, 1.0));
+    imageStore(uOutY, b + ivec2(1, 0), vec4(rgbToY(c10), 0.0, 0.0, 1.0));
+    imageStore(uOutY, b + ivec2(0, 1), vec4(rgbToY(c01), 0.0, 0.0, 1.0));
+    imageStore(uOutY, b + ivec2(1, 1), vec4(rgbToY(c11), 0.0, 0.0, 1.0));
+
+    vec3 avg = 0.25 * (c00 + c10 + c01 + c11);
+    float u = dot(avg, vec3(-0.114572, -0.385428, 0.5));
+    float v = dot(avg, vec3(0.5, -0.454153, -0.045847));
+    vec2 uv = (uFullRange != 0)
+        ? vec2(u + 0.5, v + 0.5)
+        : vec2(128.0 / 255.0 + (224.0 / 255.0) * u,
+               128.0 / 255.0 + (224.0 / 255.0) * v);
+    imageStore(uOutUV, uvPos, vec4(uv, 0.0, 1.0));
+}
+)GLSL";
+
+GLuint compileShader(GLenum type, const char *source)
+{
+    GLuint shader = glCreateShader(type);
+    if (!shader) {
+        return 0;
+    }
+    glShaderSource(shader, 1, &source, nullptr);
+    glCompileShader(shader);
+    GLint ok = GL_FALSE;
+    glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+    if (ok != GL_TRUE) {
+        char log[512] = {};
+        glGetShaderInfoLog(shader, sizeof(log), nullptr, log);
+        qCWarning(PIPEWIRERECORD_LOGGING) << "NVENC GLSL compile failed:" << log;
+        glDeleteShader(shader);
+        return 0;
+    }
+    return shader;
+}
+
+GLuint linkProgram(const char *vertSrc, const char *fragSrc)
+{
+    GLuint vs = compileShader(GL_VERTEX_SHADER, vertSrc);
+    GLuint fs = compileShader(GL_FRAGMENT_SHADER, fragSrc);
+    if (!vs || !fs) {
+        if (vs) {
+            glDeleteShader(vs);
+        }
+        if (fs) {
+            glDeleteShader(fs);
+        }
+        return 0;
+    }
+
+    GLuint prog = glCreateProgram();
+    glAttachShader(prog, vs);
+    glAttachShader(prog, fs);
+    glLinkProgram(prog);
+    glDeleteShader(vs);
+    glDeleteShader(fs);
+
+    GLint ok = GL_FALSE;
+    glGetProgramiv(prog, GL_LINK_STATUS, &ok);
+    if (ok != GL_TRUE) {
+        char log[512] = {};
+        glGetProgramInfoLog(prog, sizeof(log), nullptr, log);
+        qCWarning(PIPEWIRERECORD_LOGGING) << "NVENC GLSL link failed:" << log;
+        glDeleteProgram(prog);
+        return 0;
+    }
+    return prog;
+}
+
+GLuint linkComputeProgram(const char *computeSrc)
+{
+    GLuint cs = compileShader(GL_COMPUTE_SHADER, computeSrc);
+    if (!cs) {
+        return 0;
+    }
+
+    GLuint prog = glCreateProgram();
+    glAttachShader(prog, cs);
+    glLinkProgram(prog);
+    glDeleteShader(cs);
+
+    GLint ok = GL_FALSE;
+    glGetProgramiv(prog, GL_LINK_STATUS, &ok);
+    if (ok != GL_TRUE) {
+        char log[512] = {};
+        glGetProgramInfoLog(prog, sizeof(log), nullptr, log);
+        qCWarning(PIPEWIRERECORD_LOGGING) << "NVENC compute shader link failed:" << log;
+        glDeleteProgram(prog);
+        return 0;
+    }
+    return prog;
+}
