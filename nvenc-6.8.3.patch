+#pragma once
+
+#include "encoder_p.h"
+
+/**
+ * A software encoder that uses NVIDIA NVENC (h264_nvenc) to encode to H264.
+ *
+ * Frames are downloaded to system memory and converted to yuv420p like the
+ * other software encoders, then handed to h264_nvenc, which uploads them to
+ * the GPU and encodes in hardware. This avoids the VAAPI path, which is
+ * decode-only on NVIDIA and therefore cannot encode.
+ */
+class H264NvencEncoder : public SoftwareEncoder
+{
+public:
+    H264NvencEncoder(H264Profile profile, PipeWireProduce *produce);
+
+    bool initialize(const QSize &size) override;
+
+protected:
+    AVDictionary *buildEncodingOptions() override;
+
+private:
+    H264Profile m_profile = H264Profile::Main;
+};
