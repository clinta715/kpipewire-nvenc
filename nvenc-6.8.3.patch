+// Return DRM render nodes with NVIDIA PCI devices prioritized first.
+QList<QByteArray> findCandidateRenderNodes()
+{
+    QList<QByteArray> nvidiaNodes;
+    QList<QByteArray> otherNodes;
+
+    const int maxDevices = drmGetDevices2(0, nullptr, 0);
+    if (maxDevices <= 0) {
+        return {};
+    }
+
+    std::vector<drmDevicePtr> devices(static_cast<size_t>(maxDevices));
+    const int count = drmGetDevices2(0, devices.data(), maxDevices);
+    if (count <= 0) {
+        return {};
+    }
+
+    for (int i = 0; i < count; ++i) {
+        const drmDevicePtr dev = devices[static_cast<size_t>(i)];
+        if (!(dev->available_nodes & (1 << DRM_NODE_RENDER)) || !dev->nodes[DRM_NODE_RENDER]) {
+            continue;
+        }
+        QByteArray path(dev->nodes[DRM_NODE_RENDER]);
+        if (dev->bustype == DRM_BUS_PCI && dev->deviceinfo.pci && dev->deviceinfo.pci->vendor_id == 0x10de) {
+            nvidiaNodes.append(path);
+        } else {
+            otherNodes.append(path);
+        }
+    }
+
+    drmFreeDevices(devices.data(), count);
+    nvidiaNodes.append(otherNodes);
+    return nvidiaNodes;
+}
